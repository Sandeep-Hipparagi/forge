{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@forge/core": ["packages/core/src/index.ts"],
      "@forge/store": ["packages/store/src/index.ts"],
      "@forge/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@forge/api": ["packages/api/src/index.ts"],
      "@forge/evals/*": ["packages/evals/*"],
      "@forge/perception": ["packages/perception/src/index.ts"],
      "@forge/agents": ["packages/agents/src/index.ts"],
      "@forge/planner": ["packages/planner/src/index.ts"],
      "@forge/critic": ["packages/critic/src/index.ts"],
      "@forge/compile": ["packages/compile/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  }
}
