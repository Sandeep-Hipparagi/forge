# Model: optional during Ph0. Replay evaluation requires no key.
ANTHROPIC_API_KEY=
FORGE_MODEL=claude-opus-5
FORGE_LLM_ENABLED=false
FORGE_LLM_TIMEOUT_MS=20000

# Local services and safety defaults.
FORGE_API_PORT=4000
FORGE_API_BIND=127.0.0.1
FORGE_ALLOWED_HOSTS=localhost,127.0.0.1
FORGE_WRITE_ALLOWLIST=artifacts,apps/sut/tests
FORGE_DISPOSABLE_TARGET=false
FORGE_CONFIG_VERSION=forge/v1
FORGE_SECRET_PROVIDER=env
FORGE_FIXTURES=replay
